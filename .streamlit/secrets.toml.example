# Copy this file to .streamlit/secrets.toml for local testing.
# NEVER upload secrets.toml to GitHub. On Streamlit Cloud, paste these
# lines into: App → Settings → Secrets.

GEMINI_API_KEY = "paste-your-key-from-aistudio.google.com"

# Optional — pin a specific model instead of always using the newest Flash.
# GEMINI_MODEL = "gemini-flash-latest"
